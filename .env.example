# ToTo Company — optional environment configuration
#
# The application needs NO environment variables to run. Everything an operator
# can change lives in Settings inside the app. These exist only for development.
#
# Copy to `.env` if you want them; the file is git-ignored.

# Open the app with developer tools and verbose logging.
TOTO_DEV=1

# --- Packaging (release builds only) ---------------------------------------
# Never commit real values. Read them from your shell or CI secret store.
#
# macOS code signing and notarisation, if you have an Apple Developer ID:
# CSC_LINK=/absolute/path/to/certificate.p12
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
#
# Windows code signing:
# WIN_CSC_LINK=/absolute/path/to/certificate.pfx
# WIN_CSC_KEY_PASSWORD=
